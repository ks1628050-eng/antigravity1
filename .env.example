# ============================================
# Kedar AI — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub (it's in .gitignore)
# ============================================

# Only public frontend configuration belongs in VITE_ variables.
# AI and payment secrets must be configured as Supabase Edge Function secrets.

# ── PUBLIC FRONTEND CONFIGURATION ───────────────────────────────────────────
# Supabase project URL and anon key are safe to expose in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay publishable key ID only. The order and signature secrets stay server-side.
VITE_RAZORPAY_KEY_ID=

# Optional direct UPI display address. UPI payments are not auto-verified.
VITE_OWNER_UPI_ID=

# ── SUPABASE EDGE FUNCTION SECRETS ──────────────────────────────────────────
# Set with `supabase secrets set`, never in this file:
# GEMINI_API_KEY or OPENAI_API_KEY
# RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET
