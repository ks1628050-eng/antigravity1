# ============================================
# Kedar AI — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub (it's in .gitignore)
# ============================================

# ── 1. AI PROVIDER API KEYS (OPTIONAL — CAN ALSO BE ENTERED DIRECTLY IN SETTINGS UI) ──
# Google Gemini API Key (Get from https://aistudio.google.com)
VITE_GEMINI_API_KEY=

# Groq API Key (Ultra-fast inference: Llama 3.3 70B - Get from https://console.groq.com)
VITE_GROQ_API_KEY=

# OpenAI API Key (GPT-4o / GPT-4o-mini - Get from https://platform.openai.com)
VITE_OPENAI_API_KEY=

# OpenRouter API Key (DeepSeek R1 / Claude 3.5 - Get from https://openrouter.ai)
VITE_OPENROUTER_API_KEY=


# ── 2. SUPABASE BACKEND (OPTIONAL FOR CLOUD SYNC & AUTH) ──────────────────────
# Supabase project URL and anon key are safe to expose in browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ── 3. PAYMENT & MONETIZATION ────────────────────────────────────────────────
# Razorpay Publishable Test Key (e.g. rzp_test_...)
VITE_RAZORPAY_KEY_ID=

# Direct UPI ID for zero-fee student payments & QR codes (e.g. yourname@okaxis)
VITE_OWNER_UPI_ID=


# ── 4. SUPABASE EDGE FUNCTION SECRETS (IF DEPLOYING SUPABASE SERVER FUNCTIONS) ──
# Set with `supabase secrets set`:
# GEMINI_API_KEY=...
# RAZORPAY_KEY_ID=...
# RAZORPAY_KEY_SECRET=...
