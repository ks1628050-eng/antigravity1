# ============================================================================
# Kedar AI — Environment Variables Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env with real secrets to GitHub!
# ============================================================================

# ── 1. SUPABASE AUTH & POSTGRESQL DATABASE (Auth, RLS, Cloud Sync) ──────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── 2. SERVER-SIDE AI PROVIDER SECRETS (Never exposed in frontend bundle) ────
# Configured default provider: gemini | groq | openai | openrouter
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash

# Google Gemini API Key (Get free key at https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# Groq Cloud API Key (Get ultra-fast key at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here

# OpenAI API Key (Get from https://platform.openai.com)
OPENAI_API_KEY=your-openai-api-key-here

# OpenRouter API Key (Get from https://openrouter.ai)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Generic Fallback AI Key
AI_API_KEY=your-gemini-api-key-here

# ── 3. STUDENT DIRECT UPI PAYMENTS ──────────────────────────────────────────
# Your personal GPay / PhonePe / Paytm UPI ID to receive 100% payments directly
VITE_OWNER_UPI_ID=yourname@okaxis
